---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Destaques from '../components/Destaques.astro';
import Sobre from '../components/Sobre.astro';
import Avaliacoes from '../components/Avaliacoes.astro';
import Localizacao from '../components/Localizacao.astro';
import Final from '../components/Final.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="conteudo-principal">
    <Hero />
    <Destaques />
    <Sobre />
    <Avaliacoes />
    <Localizacao />
    <Final />
  </main>
  <Footer />
</Base>
