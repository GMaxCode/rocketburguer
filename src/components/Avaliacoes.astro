---
import { siteConfig } from '../data/site.config';

const { avaliacoes } = siteConfig;
const hasAvaliacoes = avaliacoes && avaliacoes.depoimentos && avaliacoes.depoimentos.length > 0;
---

{hasAvaliacoes && (
  <section id="avaliacoes" class="py-16 sm:py-24 bg-brand-forest text-white relative overflow-hidden" aria-labelledby="avaliacoes-heading">
    <!-- Curved Wave Shape Divider at Top (inspirado no Marco Good) -->
    <div class="absolute top-0 inset-x-0 overflow-hidden leading-none pointer-events-none" aria-hidden="true">
      <svg class="relative block w-full h-6 sm:h-10 text-white" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C150,90 350,-40 500,45 C650,130 900,-20 1200,30 L1200,0 L0,0 Z" fill="currentColor"></path>
      </svg>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 pt-4">
      
      <!-- Heading -->
      <div class="text-center max-w-xl mx-auto mb-12 sm:mb-16">
        <span class="inline-block text-xs sm:text-sm font-extrabold uppercase tracking-widest text-brand-dark bg-brand-yellow px-4 py-1.5 rounded-full mb-3">
          Opinião de quem provou
        </span>
        <h2 id="avaliacoes-heading" class="font-display text-4xl sm:text-5xl md:text-6xl uppercase tracking-wide text-white">
          O que dizem sobre nós
        </h2>
        <div class="mt-3 flex items-center justify-center gap-2 text-white text-sm">
          <span class="text-amber-300 text-base" aria-hidden="true">★★★★★</span>
          <span class="font-bold">{avaliacoes.notaMedia} de 5</span>
          <span>•</span>
          <span>{avaliacoes.totalAvaliacoes} avaliações no {avaliacoes.plataforma}</span>
        </div>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {avaliacoes.depoimentos.map((depoimento) => (
          <blockquote class="bg-white text-brand-dark rounded-3xl p-6 sm:p-8 shadow-xl flex flex-col justify-between border-2 border-white/20">
            <div>
              <!-- Stars -->
              <div class="flex text-amber-500 text-lg mb-4" aria-label={`Avaliação: ${depoimento.estrelas} de 5 estrelas`}>
                {'★'.repeat(depoimento.estrelas)}
              </div>
              
              <!-- Quote -->
              <p class="text-gray-900 text-base sm:text-lg italic leading-relaxed">
                "{depoimento.comentario}"
              </p>
            </div>

            <!-- Author & Platform -->
            <footer class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
              <cite class="not-italic font-bold text-sm text-brand-forest">
                {depoimento.autor}
              </cite>
              <span class="text-[11px] font-bold uppercase tracking-wider text-gray-700 bg-gray-100 px-2.5 py-1 rounded-md">
                {depoimento.origem}
              </span>
            </footer>
          </blockquote>
        ))}
      </div>

    </div>
  </section>
)}
