---
import { siteConfig, buildOrderUrl } from '../data/site.config';

const finalOrderUrl = buildOrderUrl('final');
---

<section class="py-16 sm:py-24 bg-brand-forest text-white relative overflow-hidden" aria-labelledby="final-heading">
  <!-- Accent Lighting Background -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-brand-orange/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center">
    
    <span class="inline-block text-xs sm:text-sm font-extrabold uppercase tracking-widest text-brand-dark bg-brand-yellow px-4 py-1.5 rounded-full mb-4">
      Sua Fome Não Pode Esperar
    </span>

    <h2 id="final-heading" class="font-display text-4xl sm:text-6xl md:text-7xl uppercase tracking-wide leading-tight mb-5">
      Pronto para decolar nessa <span class="text-brand-yellow">experiência?</span>
    </h2>

    <p class="text-base sm:text-lg text-white/90 max-w-xl mx-auto leading-relaxed mb-10">
      Peça seu hambúrguer artesanal favorito em poucos toques no cardápio online ou fale diretamente com a nossa equipe.
    </p>

    <!-- CTAs Group -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      
      <!-- Primary: Order Now -->
      <a
        href={finalOrderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-orange hover:bg-brand-orange-hover text-white font-extrabold text-base uppercase tracking-wider shadow-xl shadow-black/20 transition-all hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-brand-yellow"
      >
        <span>Fazer Pedido Agora</span>
        <svg class="w-5 h-5 ml-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>

      <!-- Secondary: WhatsApp -->
      <a
        href={siteConfig.whatsapp.link}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-sm uppercase tracking-wider shadow-lg transition-all hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-400"
      >
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Tertiary: Instagram -->
      <a
        href={siteConfig.instagram.link}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm uppercase tracking-wider transition-all hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-white/30"
      >
        <svg class="w-5 h-5 mr-2 text-pink-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
        </svg>
        <span>Instagram</span>
      </a>

    </div>

  </div>
</section>
