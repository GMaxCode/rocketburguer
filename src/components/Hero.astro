---
import { siteConfig, buildOrderUrl } from '../data/site.config';

const heroOrderUrl = buildOrderUrl('hero');
---

<section class="relative bg-brand-forest text-white overflow-hidden pt-8 pb-16 md:pt-14 md:pb-24 lg:pb-32" aria-labelledby="hero-heading">
  <!-- Organic Background Accent Shape (inspirado no Marco Good) -->
  <div class="absolute -right-24 -bottom-32 md:-right-16 md:-bottom-24 w-[380px] h-[380px] md:w-[650px] md:h-[650px] bg-brand-yellow/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute left-[-100px] top-[-100px] w-72 h-72 bg-brand-orange/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Text & Action Content -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Social Proof Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-semibold tracking-wide text-white mb-5">
          <span class="flex text-amber-300" aria-hidden="true">★★★★★</span>
          <span class="text-white font-bold">{siteConfig.avaliacoes.notaMedia}</span>
          <span class="text-white/80">({siteConfig.avaliacoes.totalAvaliacoes} avaliações no Google)</span>
        </div>

        <!-- Main Heading (H1) -->
        <h1 id="hero-heading" class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-7xl tracking-wide uppercase leading-[0.95] text-white mb-5">
          Hambúrguer <span class="text-brand-yellow">artesanal</span> de outro <span class="text-brand-yellow">planeta.</span>
        </h1>

        <!-- Supporting Subtitle -->
        <p class="text-base sm:text-lg text-white/90 max-w-xl leading-relaxed mb-8">
          Blends suculentos de 150g, bacon crocante, receitas exclusivas e os famosos lanches temáticos como o Apollo 7 e Saturno 5. Escolha seus favoritos e receba quentinho em Ji-Paraná.
        </p>

        <!-- CTA & Schedule Badge -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href={heroOrderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-orange hover:bg-brand-orange-hover text-white font-extrabold text-base tracking-wide uppercase shadow-xl shadow-black/20 transition-all hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-brand-yellow"
          >
            <span>Pedir agora</span>
            <svg class="w-5 h-5 ml-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>

          <!-- Schedule status -->
          <div class="flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-white/10 border border-white/15 text-xs sm:text-sm text-white">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
            </span>
            <span class="font-medium">{siteConfig.horario.dias} • {siteConfig.horario.horarioFuncionamento}</span>
          </div>
        </div>

        <!-- Highlight perks -->
        <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-3 gap-4 w-full max-w-lg text-white/90 text-xs sm:text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-yellow shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Carne 100% artesanal</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-yellow shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Entrega rápida</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-yellow shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Mesas externas</span>
          </div>
        </div>

      </div>

      <!-- Hero Visual -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-4 lg:mt-0">
        <!-- Glow / Background circle -->
        <div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-brand-yellow/20 -z-0"></div>

        <!-- Floating sticker style tag -->
        <div class="absolute -top-3 right-4 sm:right-8 z-20 bg-brand-yellow text-brand-dark font-display text-base sm:text-lg px-4 py-1.5 rounded-full rotate-6 shadow-lg border-2 border-brand-dark uppercase tracking-wide">
          Sabor Interestelar!
        </div>

        <div class="relative z-10 w-full max-w-[420px] lg:max-w-none">
          <picture>
            <source
              type="image/webp"
              srcset="/images/hero-burger-400.webp 400w, /images/hero-burger-800.webp 800w, /images/hero-burger-1200.webp 1200w"
              sizes="(max-width: 640px) 360px, (max-width: 1024px) 450px, 500px"
            />
            <img
              src="/images/hero-burger-400.webp"
              alt="Hambúrguer artesanal Rocket Burger duplo com queijo derretido e bacon crocante"
              width="400"
              height="400"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="w-full h-auto object-cover rounded-3xl shadow-2xl ring-4 ring-white/10"
            />
          </picture>
        </div>

      </div>

    </div>
  </div>
</section>
